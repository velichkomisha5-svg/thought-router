{
  "expo": {
    "name": "ThoughtRouter",
    "slug": "thought-router",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.velychko.thoughtrouter",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Доступ к микрофону необходим для записи аудиозаметок.",
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    }
  }
}
